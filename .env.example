# GitHub Configuration for Dynamic Blog System
# Account/Organization containing the blog repositories
GITHUB_OWNER=developmentlag

# (Recommended) GitHub Personal Access Token
# - Required for private repositories
# - Increases API rate limit from 60 to 5,000 requests/hour for public repositories
# Scopes needed: 'public_repo' for public repositories, or 'repo' / 'Contents: Read-only' for private repositories
GITHUB_TOKEN=

# Resend API credentials for website inquiry emails
RESEND_API_KEY=
# Must be an address on a domain verified in Resend
RESEND_FROM_EMAIL=
